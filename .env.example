# Postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Redis
REDIS_URL=redis://redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
OLLAMA_MODEL=qwen2.5:1.5b
# Leave empty for stable process. Set to --reload for hot-reload dev mode.
API_RELOAD=

# Web (server-side fetch dentro de Docker)
API_URL=http://api:8000

# Puertos expuestos al host
API_PORT_HOST=8000
WEB_PORT_HOST=3000
POSTGRES_PORT_HOST=5432
REDIS_PORT_HOST=6379
